---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

const year = new Date().getFullYear();

const quickLinks = [
	{ label: "Home", href: "/" },
	{ label: "About Us", href: "/about" },
	{ label: "Our Services", href: "/services" },
	{ label: "Contact Us", href: "/contact" },
];
---

<div class="w-full bg-navy flex items-center justify-center">
	<div
		class="max-w-[1280px] w-full px-5 md:px-12 lg:px-16 pt-16 pb-6 flex flex-col gap-12 font-main"
	>
		<div class="flex flex-col md:flex-row justify-between gap-10 md:gap-8">
			<div class="flex flex-col gap-3 md:max-w-[320px]">
				<div
					class="text-22 md:text-24 font-bold font-title text-white leading-tight"
				>
					Impact GovCon Solutions LLC
				</div>
				<p class="text-14 text-white/60 font-body leading-6">
					Federal capture strategy, proposal compliance, and technical
					execution from Canton, Ohio.
				</p>
			</div>
			<div class="flex flex-col gap-4">
				<div
					class="text-12 font-bold uppercase tracking-wider text-white/50 font-main"
				>
					Navigation
				</div>
				<div
					class="flex flex-col gap-3 text-14 text-white/80 font-body"
				>
					{
						quickLinks.map((link) => (
							<a
								href={link.href}
								class="hover:text-red transition-colors duration-300 w-max"
							>
								{link.label}
							</a>
						))
					}
				</div>
			</div>
			<div class="flex flex-col gap-4">
				<div
					class="text-12 font-bold uppercase tracking-wider text-white/50 font-main"
				>
					Contact Us
				</div>
				<div
					class="flex flex-col gap-3 text-14 text-white/80 font-body max-w-[260px]"
				>
					<div>
						<span class="text-white font-semibold"
							>Impact GovCon Solutions LLC</span
						>
					</div>
					<div>
						<div
							class="text-white/50 text-12 uppercase tracking-wide mb-1"
						>
							Location:
						</div>
						<div>6545 Market Ave N, Suite 100,</div>
						<div>Canton, OH 44721, USA</div>
					</div>
					<div
						class="text-white/50 text-12 uppercase tracking-wide mt-1"
					>
						Confidential solicitation &amp; technical inquiries:
					</div>
					<div class="flex flex-col">
						<span
							class="text-white/50 text-12 uppercase tracking-wide mb-1"
							>E-mail:</span
						>
						<a
							href="mailto:info@impactgovconsolutions.com"
							class="underline hover:text-red transition-colors duration-300 w-max"
						>
							info@impactgovconsolutions.com
						</a>
					</div>
				</div>
			</div>
		</div>
		<div class="w-full h-px bg-white/10"></div>
		<div
			class="flex flex-col md:flex-row items-center justify-between gap-4 text-12 text-white/50 font-body"
		>
			<div>
				&copy; {year} Impact GovCon Solutions. Impact GovCon Solutions LLC.
				All rights reserved.
			</div>
			<div class="flex items-center gap-6">
				<a
					href="https://www.linkedin.com/company/impact-govcon-solutions"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					class="text-white/70 hover:text-red transition-colors duration-300 flex items-center gap-1.5"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 14 14" fill="none">
						<path d="M13.5221 13.3011V13.3006H13.5253V8.53281C13.5253 6.20039 13.0232 4.40369 10.2965 4.40369C8.98562 4.40369 8.10595 5.12302 7.74683 5.80498H7.70891V4.62144H5.12354V13.3006H7.81562V9.00298C7.81562 7.87144 8.03012 6.77727 9.43141 6.77727C10.8121 6.77727 10.8327 8.0686 10.8327 9.07556V13.3011H13.5221Z" fill="currentColor"/>
						<path d="M0.740234 4.62183H3.43557V13.301H0.740234V4.62183Z" fill="currentColor"/>
						<path d="M2.08647 0.300781C1.22468 0.300781 0.525391 1.00007 0.525391 1.86186C0.525391 2.72366 1.22468 3.43757 2.08647 3.43757C2.94827 3.43757 3.64756 2.72366 3.64756 1.86186C3.64702 1.00007 2.94772 0.300781 2.08647 0.300781V0.300781Z" fill="currentColor"/>
					</svg>
					<span>LinkedIn</span>
				</a>
				<a
					href="/privacy-policy"
					class="hover:text-red transition-colors duration-300"
					>Privacy Policy</a
				>
				<a
					href="/terms-conditions"
					class="hover:text-red transition-colors duration-300"
					>Terms &amp; Conditions</a
				>
			</div>
		</div>
	</div>
</div>
