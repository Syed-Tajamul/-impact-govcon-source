---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

interface Props {
	title: string;
	description: string;
	icon:
		| "target"
		| "briefcase"
		| "check"
		| "checkShield"
		| "dollar"
		| "document"
		| "compass"
		| "users"
		| "truck"
