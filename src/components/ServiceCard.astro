---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

interface Props {
	title: string;
	description: string;
	icon: "target" | "briefcase" | "check" | "checkShield" | "dollar";
}

const { title, description, icon } = Astro.props;

const icons: Record<string, string> = {
	target: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 12.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 17.25a5.25 5.25 0 1 0 0-10.5 5.25 5.25 0 0 0 0 10.5Z" /></svg>`,
	briefcase: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25a2 2 0 0 1-2 2H5.75a2 2 0 0 1-2-2v-4.25M20.25 14.15a2.25 2.25 0 0 0-1.632-2.163L15 11.25M20.25 14.15a2.25 2.25 0 0 1-1.632 2.163L15 17.25M3.75 14.15a2.25 2.25 0 0 1 1.632-2.163L9 11.25M3.75 14.15a2.25 2.25 0 0 0 1.632 2.163L9 17.25M9 11.25V9a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3v2.25M9 11.25h6M9 17.25h6" /></svg>`,
	check: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>`,
	checkShield: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 4.556-3.04 8.53-7.5 9.75-4.46-1.22-7.5-5.194-7.5-9.75V6.108a2.25 2.25 0 0 1 1.632-2.163l5.25-1.5a2.25 2.25 0 0 1 1.236 0l5.25 1.5A2.25 2.25 0 0 1 21 6.108V12Z" /></svg>`,
	dollar: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m3-9.75c0-1.243-1.343-2.25-3-2.25s-3 1.007-3 2.25 1.343 2.25 3 2.25 3 1.007 3 2.25-1.343 2.25-3 2.25-3-1.007-3-2.25" /></svg>`,
};
---

<div
	class="group flex flex-col gap-4 bg-white border border-borderGrey rounded-xl p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-cardHover"
>
	<div
		class="w-11 h-11 rounded-lg bg-red/10 text-red flex items-center justify-center group-hover:bg-red group-hover:text-white transition-colors duration-300"
		set:html={icons[icon]}
	/>
	<h3 class="text-18 md:text-20 font-bold font-title text-navy">
		{title}
	</h3>
	<p class="text-14 text-bodyGrey font-body leading-relaxed">
		{description}
	</p>
</div>
