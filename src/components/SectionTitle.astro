---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

interface Props {
	eyebrow?: string;
	text?: string;
	focusText?: string;
	align?: "left" | "center";
	darkMode?: boolean;
}

const {
	eyebrow,
	text,
	focusText,
	align = "left",
	darkMode = false,
} = Astro.props;
---

<div
	class={`flex flex-col gap-3 ${align === "center" ? "items-center text-center" : "items-start text-left"}`}
>
	{
		eyebrow && (
			<span class="text-12 md:text-14 font-bold uppercase tracking-wider text-red font-main">
				{eyebrow}
			</span>
		)
	}
	<h2
		class={`text-28 md:text-40 font-bold font-title leading-tight ${darkMode ? "text-white" : "text-navy"}`}
	>
		{text}
		{focusText && <span class="text-red">{focusText}</span>}
	</h2>
</div>
