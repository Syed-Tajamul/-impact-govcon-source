---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

interface Props {
	name: string;
	role: string;
	bio: string;
	img: string;
	reverse?: boolean;
	linkedin?: string;
	email?: string;
}

const { name, role, bio, img, reverse = false, linkedin, email } = Astro.props;
---

<div
	class={`flex flex-col ${reverse ? "md:flex-row-reverse" : "md:flex-row"} items-center gap-10 md:gap-14 w-full`}
>
	<div class="w-full md:w-[280px] flex-shrink-0 animate-on-scroll">
		<img
			src={img}
			alt={name}
			class="w-full max-w-[280px] mx-auto rounded-2xl object-cover shadow-cardHover"
		/>
	</div>
	<div class="flex flex-col gap-3 animate-on-scroll-right">
		<div class="w-10 h-1 bg-red rounded"></div>
		<span class="text-14 font-semibold uppercase tracking-wider text-red font-main">
			{role}
		</span>
		<h3 class="text-28 md:text-32 font-bold font-title text-navy">
			{name}
		</h3>
		<p class="text-15 md:text-16 text-bodyGrey font-body leading-relaxed max-w-xl">
			{bio}
		</p>
		{
			(linkedin || email) && (
				<div class="flex items-center gap-3 pt-2">
					{linkedin && (
						<a
							href={linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="w-10 h-10 rounded-full flex items-center justify-center bg-cardGrey hover:bg-[#0077b5] text-[#0077b5] hover:text-white border border-borderGrey hover:border-[#0077b5] shadow-sm transition-all duration-300 hover:-translate-y-0.5"
							aria-label={`${name}'s LinkedIn Profile`}
							title={`LinkedIn Profile`}
						>
							<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
								<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
							</svg>
						</a>
					)}
					{email && (
						<a
							href={`mailto:${email}`}
							class="w-10 h-10 rounded-full flex items-center justify-center bg-cardGrey hover:bg-red text-navy hover:text-white border border-borderGrey hover:border-red shadow-sm transition-all duration-300 hover:-translate-y-0.5"
							aria-label={`Email ${name}`}
							title={`Email: ${email}`}
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
						</a>
					)}
				</div>
			)
		}
	</div>
</div>
