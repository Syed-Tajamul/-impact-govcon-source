---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

import Button from "./Button.astro";

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	primaryButtonText: string;
	primaryButtonHref?: string;
	secondaryButtonText?: string;
	secondaryButtonHref?: string;
	compact?: boolean;
	image?: string;
	imageAlt?: string;
}

const {
	eyebrow,
	title,
	description,
	primaryButtonText,
	primaryButtonHref = "/contact",
	secondaryButtonText,
	secondaryButtonHref,
	compact = false,
	image,
	imageAlt = "",
} = Astro.props;
---

<div class={`w-full bg-navy flex items-center justify-center relative overflow-hidden ${compact ? "" : "min-h-[calc(100vh-76px)]"}`}>
	<div
		class={`max-w-[1360px] w-full px-5 md:px-10 lg:px-12 ${compact ? "py-12 lg:py-16" : "py-6 md:py-8 lg:py-10"} flex ${image ? "flex-col lg:flex-row lg:items-center gap-8 lg:gap-10" : "flex-col"} ${compact ? "items-center text-center" : "items-start text-left"} relative z-10`}
	>
		<div class={`flex flex-col gap-4 md:gap-5 ${image ? "w-full lg:flex-[1.15]" : "w-full"} ${compact ? "items-center text-center" : "items-start text-left"}`}>
			<span class="text-13 md:text-14 font-semibold tracking-wider uppercase text-red font-main animate-on-scroll">
				{eyebrow}
			</span>
			<h1
				class={`text-24 sm:text-28 md:text-[32px] lg:text-[35px] xl:text-[38px] font-bold font-title text-white leading-[1.3] md:leading-[1.32] animate-on-scroll ${compact ? "max-w-4xl" : "w-full"}`}
				set:html={title}
			/>
			<p
				class={`text-15 md:text-16 text-white/80 font-body leading-relaxed animate-on-scroll ${compact ? "max-w-2xl" : "max-w-xl"}`}
			>
				{description}
			</p>
			<div class="flex flex-wrap gap-4 pt-1 animate-on-scroll">
				<Button text={primaryButtonText} href={primaryButtonHref} variant="filled" pulseEffect={true} />
				{
					secondaryButtonText && (
						<Button text={secondaryButtonText} href={secondaryButtonHref} variant="outlineLight" />
					)
				}
			</div>
		</div>
		{
			image && (
				<div class="w-full lg:flex-[0.85] max-w-xl lg:max-w-none animate-on-scroll-right">
					<div class="relative">
						<div class="absolute -inset-2.5 rounded-2xl border border-red/30" />
						<img
							src={image}
							alt={imageAlt}
							class="relative w-full h-[240px] md:h-[280px] lg:h-[320px] xl:h-[340px] object-cover rounded-2xl shadow-cardHover"
						/>
					</div>
				</div>
			)
		}
	</div>
</div>
