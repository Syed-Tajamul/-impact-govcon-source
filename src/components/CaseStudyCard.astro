---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

interface Props {
	tag: string;
	title: string;
	description: string;
	img?: string;
	reverse?: boolean;
}

const { tag, title, description, img, reverse = false } = Astro.props;
---

<div
	class={`flex flex-col ${reverse ? "md:flex-row-reverse" : "md:flex-row"} items-center gap-8 md:gap-12 w-full`}
>
	<div class="flex-1 flex flex-col gap-3 animate-on-scroll">
		<span class="text-12 font-semibold uppercase tracking-wider text-red font-main">
			{tag}
		</span>
		<h3 class="text-22 md:text-28 font-bold font-title text-navy leading-tight">
			{title}
		</h3>
		<p class="text-14 md:text-16 text-bodyGrey font-body leading-relaxed">
			{description}
		</p>
	</div>
	<div class="flex-1 w-full animate-on-scroll-right">
		{
			img ? (
				<img src={img} alt={title} class="w-full h-56 md:h-64 object-cover rounded-xl shadow-card" />
			) : (
				<div class="w-full h-56 md:h-64 rounded-xl bg-gradient-to-br from-navy to-navyLight flex items-center justify-center shadow-card">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="white" class="w-16 h-16 opacity-40">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" />
					</svg>
				</div>
			)
		}
	</div>
</div>
