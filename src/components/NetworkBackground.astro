---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

interface Props {
	id?: string;
}

const { id = "network-bg" } = Astro.props;
---

<canvas id={id} class="absolute inset-0 w-full h-full pointer-events-none"
></canvas>

<script data-astro-rerun define:vars={{ id }}>
	(function () {
		const canvas = document.getElementById(id);
		if (!canvas || canvas.dataset.initialized === "true") return;
		canvas.dataset.initialized = "true";

		const ctx = canvas.getContext("2d");
		let width = 0;
		let height = 0;
		let points = [];
		let rafId = null;

		function resize() {
			const parent = canvas.parentElement;
			if (!parent) return;
			width = canvas.width = parent.offsetWidth;
			height = canvas.height = parent.offsetHeight;
			// Denser, smaller dots read closer to the reference pattern
			const count = Math.max(
				30,
				Math.min(90, Math.floor((width * height) / 9000)),
			);
			points = Array.from({ length: count }, () => ({
				x: Math.random() * width,
				y: Math.random() * height,
				vx: (Math.random() - 0.5) * 0.25,
				vy: (Math.random() - 0.5) * 0.25,
			}));
		}

		function tick() {
			if (!ctx || !width || !height) {
				rafId = requestAnimationFrame(tick);
				return;
			}
			ctx.clearRect(0, 0, width, height);
			for (const p of points) {
				p.x += p.vx;
				p.y += p.vy;
				if (p.x < 0 || p.x > width) p.vx *= -1;
				if (p.y < 0 || p.y > height) p.vy *= -1;
			}
			for (let i = 0; i < points.length; i++) {
				for (let j = i + 1; j < points.length; j++) {
					const a = points[i];
					const b = points[j];
					const dist = Math.hypot(a.x - b.x, a.y - b.y);
					if (dist < 110) {
						ctx.strokeStyle = `rgba(255,255,255,${0.16 * (1 - dist / 110)})`;
						ctx.lineWidth = 0.6;
						ctx.beginPath();
						ctx.moveTo(a.x, a.y);
						ctx.lineTo(b.x, b.y);
						ctx.stroke();
					}
				}
			}
			for (const p of points) {
				ctx.fillStyle = "rgba(255,255,255,0.55)";
				ctx.beginPath();
				ctx.arc(p.x, p.y, 1.3, 0, Math.PI * 2);
				ctx.fill();
			}
			rafId = requestAnimationFrame(tick);
		}

		// Wait a frame so the parent card has its final layout size
		requestAnimationFrame(() => {
			resize();
			tick();
		});

		const resizeObserver = new ResizeObserver(() => resize());
		resizeObserver.observe(canvas.parentElement);

		document.addEventListener(
			"astro:before-swap",
			() => {
				if (rafId) cancelAnimationFrame(rafId);
				resizeObserver.disconnect();
			},
			{ once: true },
		);
	})();
</script>
