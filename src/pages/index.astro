---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
import IndustryCard from "../components/IndustryCard.astro";
import CaseStudyCarousel from "../components/CaseStudyCarousel.astro";
import PlatformsMarquee from "../components/PlatformsMarquee.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Button from "../components/Button.astro";
import { services } from "../data/services";
import { industries } from "../data/industries";
---

<Layout
	title="Impact GovCon Solutions LLC | Federal Capture Strategy & Technical Execution"
>
	<Hero
		eyebrow="Target Public-Sector Markets"
		title="Supporting Your Federal Market Growth"
		description="We align your capabilities with specific agency buying trends and commercial sector opportunities, ensuring strategic market entry and sustained growth."
		primaryButtonText="Discuss Your Sector"
		primaryButtonHref="/contact"
		image="/hero/team-office.jpg"
		imageAlt="Impact GovCon Solutions team at their Canton, Ohio office"
	/>

	<Section backgroundColor="white">
		<div class="flex flex-col gap-10 w-full">
			<SectionTitle
				eyebrow="Core Advisory"
				text="Government Contracting "
				focusText="Services"
				align="center"
			/>
			<p
				class="text-16 text-bodyGrey font-body text-center max-w-2xl mx-auto -mt-4 animate-on-scroll"
			>
				Navigate the federal marketplace with expert guidance across the
				entire capture lifecycle, from opportunity identification to
				contract financing readiness.
			</p>
			<div
				class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full animate-on-scroll"
			>
				{
					services.map((service) => (
						<ServiceCard
							title={service.title}
							description={service.description}
							icon={service.icon}
						/>
					))
				}
			</div>
			<div class="mx-auto mt-2">
				<Button
					text="Explore Our Services"
					href="/services"
					variant="outline"
					arrow={true}
				/>
			</div>
		</div>
	</Section>

	<Section backgroundColor="cardGrey">
		<div class="flex flex-col gap-10 w-full">
			<SectionTitle
				eyebrow="Strategic Focus"
				text="Markets We "
				focusText="Support"
				align="center"
			/>
			<div
				class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 w-full animate-on-scroll"
			>
				{
					industries
						.slice(0, 6)
						.map((industry) => (
							<IndustryCard
								title={industry.title}
								description={industry.description}
							/>
						))
				}
			</div>
			<div class="mx-auto mt-2">
				<Button
					text="View All Industries"
					href="/industries"
					variant="filled"
					arrow={true}
				/>
			</div>
		</div>
	</Section>

	<Section backgroundColor="white">
		<div class="flex flex-col gap-12 w-full max-w-[900px]">
			<SectionTitle
				eyebrow="Representative Solutions"
				text="Illustrative Scenarios in "
				focusText="GovCon Success"
				align="center"
			/>
			<CaseStudyCarousel />
			<div class="mx-auto mt-2">
				<Button
					text="See All Case Studies"
					href="/case-studies"
					variant="outline"
					arrow={true}
				/>
			</div>
		</div>
	</Section>

	<PlatformsMarquee />

	<CtaBanner
		id="home-cta-network"
		heading="Ready to grow your"
		highlight="federal market"
		headingSuffix="presence?"
		description="Schedule a strategy meeting with our team to discuss your capture goals and technical execution needs."
		buttonText="Let's Schedule a Strategy Meeting"
		buttonHref="/contact"
	/>
</Layout>
