---
/**
 * Impact GovCon Solutions LLC
 * @link https://impactgovconsolutions.com
 */

import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<Layout title="Privacy Policy | Impact GovCon Solutions LLC">
	<Section backgroundColor="white" paddingY="py-16 lg:py-20">
		<div class="flex flex-col gap-8 w-full max-w-3xl mx-auto">
			<SectionTitle text="Privacy " focusText="Policy" align="left" />
			<div class="flex flex-col gap-6 text-15 text-bodyGrey font-body leading-relaxed">
				<p>
					Impact GovCon Solutions LLC ("we," "us," or "our") respects your privacy. This Privacy Policy explains how we collect, use, and safeguard information when you visit our website or engage our services.
				</p>
				<div>
					<h3 class="text-18 font-bold font-title text-navy mb-2">Information We Collect</h3>
					<p>
						We may collect contact details you provide directly, such as your name, email address, phone number, and company information, when you submit an inquiry or request a strategy meeting.
					</p>
				</div>
				<div>
					<h3 class="text-18 font-bold font-title text-navy mb-2">How We Use Information</h3>
					<p>
						Information submitted through our site is used solely to respond to inquiries, schedule consultations, and provide the services requested. We do not sell or rent your information to third parties.
					</p>
				</div>
				<div>
					<h3 class="text-18 font-bold font-title text-navy mb-2">Confidentiality</h3>
					<p>
						Solicitation and technical inquiries submitted to our team are treated as confidential and are used only for the purpose of evaluating and supporting your capture and proposal needs.
					</p>
				</div>
				<div>
					<h3 class="text-18 font-bold font-title text-navy mb-2">Contact Us</h3>
					<p>
						If you have questions about this Privacy Policy, please contact us at
						<a href="mailto:info@impactgovconsolutions.com" class="text-red underline">info@impactgovconsolutions.com</a>.
					</p>
				</div>
			</div>
		</div>
	</Section>
</Layout>
